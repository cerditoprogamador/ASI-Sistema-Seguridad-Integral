<?xml version="1.0" encoding="utf-8"?>
<!--
  server.js sirve HTTP plano en desarrollo (no hay TLS configurado). Android bloquea
  tráfico cleartext por default desde API 28, así que acá se habilita solo para los
  hosts de desarrollo típicos:
    - 10.0.2.2      -> alias del emulador Android hacia localhost del host
    - localhost/127.0.0.1 -> dispositivo físico corriendo el backend localmente (poco común)
  Si conectás desde un dispositivo físico a un backend en tu LAN (ej. 192.168.x.x),
  agregá ese domain acá. En producción el backend debería tener TLS y este archivo
  debería dejar de declarar cleartext-permitted domains.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
